VITE_SUPABASE_URL=https://naiakscryafhvcghjmzx.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_key

# Yönetici paneli (git’e gerçek adres koyma). Vite bunu istemci paketına gömer; asıl koruma sonraki RLS aşaması.
VITE_ADMIN_EMAIL=your_admin_email

# Model anahtarı yalnızca Supabase secret olarak kalır (Dashboard → Edge Functions → Secrets).
# Tarayıcıya VITE_GEMINI_API_KEY koyma.

# Görüşme (Edge Function secrets; Vite/Vercel VITE_ olarak koyma):
# LIVEKIT_URL
# LIVEKIT_API_KEY
# LIVEKIT_API_SECRET

# Shopier webhook (Vercel /api/shopier/webhook). Yalnız Vercel Production env, Sensitive; VITE_ olarak koyma:
# SHOPIER_WEBHOOK_TOKEN
# SHOPIER_PAT
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY

# Yerel Supabase Auth Google (VITE_ yok; tarayıcıya/Vercel’e koyma).
# Canlı secret yalnızca Dashboard → Authentication → Providers → Google.
# YKS_GOOGLE_CLIENT_ID=
# YKS_GOOGLE_CLIENT_SECRET=
